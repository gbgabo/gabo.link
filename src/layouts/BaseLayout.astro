---
import '~/styles/global.css';
import '~/styles/pagefind.css';
import { Font } from 'astro:assets';

import { getLocaleFromPath, getHTMLTextDir } from 'intlayer';

import MetaTags from '~/components/common/MetaTags.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import SearchModal from '~/components/widgets/SearchModal.astro';

import { MetaSEO } from '~/types';
import { SITE } from '~/config.mjs';
import { getAsset } from '~/utils/permalinks';

export interface Props {
  meta?: MetaSEO;
}

const { meta = {} } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} dir={getHTMLTextDir(locale)} class="2xl:text-[20px]">
  <head>
    <MetaTags {...meta} />
    <Font cssVariable="--font-jetbrains-mono" />
    <link href={getAsset('prism.css')} rel="stylesheet" />
    {
      Astro.url.hostname !== 'localhost' && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="0c3a6cb6-9ef4-4e17-ac7c-403fdfc6ef1f"
        />
      )
    }
  </head>

  <body class="text-page bg-light dark:bg-dark tracking-tight antialiased dark:text-slate-300">
    <SearchModal />
    <slot />
    <BasicScripts />
  </body>
</html>
