---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getAsset, getPermalink } from '~/utils/permalinks';
import { bentoGrids } from '~/data';
import { getIntlayer, getLocaleFromPath, getPrefix, localeMap } from 'intlayer';
import type { LocalesValues } from 'intlayer';

import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/blog/Headline.astro';
import Chip from '~/components/widgets/Chip.astro';
import ExternalLink from '~/components/blog/content/ExternalLink.astro';
import Bento from '~/components/widgets/Bento.astro';

export const getStaticPaths = () => localeMap(({ locale }) => ({ params: { locale: getPrefix(locale).localePrefix } }));

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const { meta: metadata, aliases, title, subtitle, uses, topics, nav, skills, contact } = getIntlayer('about', locale);

const use = [
  {
    title: uses.content.uses.title,
    description: uses.content.uses.description,
    href: getPermalink(Astro.url.pathname, 'uses'),
    icon: 'tabler:app-window',
    external: false,
  },
  {
    title: uses.content.dotfiles.title,
    description: uses.content.dotfiles.description,
    href: 'https://github.com/gbgabo/dotfiles',
    icon: 'tabler:terminal-2',
    external: true,
  },
];
const topicsList = [
  {
    title: topics.content.foss.title,
    description: topics.content.foss.description,
    icon: 'ph:hand-fist-bold',
  },
  {
    title: topics.content.ricing.title,
    description: topics.content.ricing.description,
    icon: 'mdi:linux',
  },
  {
    title: topics.content.webdev.title,
    description: topics.content.webdev.description,
    icon: 'ic:round-code',
  },
  {
    title: topics.content.lists.title,
    description: topics.content.lists.description,
    icon: 'mdi:web',
  },
];
const skillsList = [
  {
    title: 'Javascript',
    icon: 'mdi:language-javascript',
  },
  {
    title: 'Typescript',
    icon: 'mdi:language-typescript',
  },
  {
    title: 'HTML',
    icon: 'simple-icons:html5',
  },
  {
    title: 'CSS',
    icon: 'simple-icons:css3',
  },
  {
    title: 'Next.js',
    icon: 'simple-icons:nextdotjs',
  },
  {
    title: 'Tailwind',
    icon: 'simple-icons:tailwindcss',
  },
  {
    title: 'Shell Script',
    icon: 'simple-icons:gnubash',
  },
  {
    title: 'Astro',
    icon: 'simple-icons:astro',
  },
  {
    title: 'Python',
    icon: 'simple-icons:python',
  },
  {
    title: 'Laravel',
    icon: 'mdi:laravel',
  },
  {
    title: 'Livewire',
    icon: 'devicon-plain:livewire',
  },
  {
    title: 'Linux',
    icon: 'simple-icons:linux',
  },
];
const links = [
  {
    title: nav.cv,
    href: getAsset(`/cvs/gabriel-gaboardi-${locale}.pdf`),
    icon: 'mdi:language-javascript',
  },
  {
    title: 'contact@gabo.link',
    href: 'mailto:contact@gabo.link',
    icon: 'mdi:language-javascript',
  },
  {
    title: 'LinkedIn',
    href: 'https://www.linkedin.com/in/gabriel-gaboardi/',
    icon: 'mdi:language-javascript',
  },
  {
    title: 'Github',
    href: 'https://github.com/gbgabo',
    icon: 'mdi:language-javascript',
  },
];

const meta = {
  title: metadata.title,
  description: metadata.description,
  image: `/api/og${Astro.url.pathname}.png`,
};
---

<Layout breadcrumbs={[{ title: metadata.title, href: '#top' }]} {meta}>
  <div class="mx-auto max-w-7xl px-6 pt-12 sm:px-6 sm:py-16 lg:py-20">
    <div class="grid grid-cols-(--grid-main-left)">
      <div class="col-start-1 col-end-2">
        <Headline left
          >/<span class="lowercase">{metadata.title}</span><span class="text-muted">
            #<span class="me">me</span></span
          ></Headline
        >
        <p class="my-8 text-lg">{subtitle}</p>
        <Picture
          class="my-8 w-full max-w-4xl rounded-md"
          widths={[400, 768, 1024, 2040]}
          sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
          width={1120}
          height={480}
          loading="eager"
          src={import('~/assets/images/about.jpg')}
          alt="screenshot"
        />
        <h2 class="my-8 text-2xl font-bold md:text-3xl">{title}</h2>
        <section>
          <h2
            class="text-grape dark:text-light-purple scroll-mt-28 text-lg font-semibold tracking-wide uppercase"
            id="education"
          >
            {nav.education}
          </h2>
          <div class="my-8">
            <Bento blocks={bentoGrids(locale).academics} />
          </div>
        </section>
        <!-- Skills -->
        <section>
          <h2
            class="text-grape dark:text-light-purple scroll-mt-28 text-lg font-semibold tracking-wide uppercase"
            id="skills"
          >
            {skills.header}
          </h2>
          <ul class="my-8 grid grid-cols-2 gap-x-3 gap-y-5 md:grid-cols-4">
            {
              skillsList.map(({ title, icon }) => {
                return (
                  <li class="inline-flex items-center">
                    <Icon name={icon} class="icon-light text-light-purple dark:text-light-purple m-2 h-7 w-7" />
                    <p class="ml-2">{title}</p>
                  </li>
                );
              })
            }
          </ul>
          <ExternalLink class="mb-8" variant="secondary" href="projects">{skills.cta}</ExternalLink>
        </section>
        <!-- Topics  -->
        <section class="prose-a:text-grape dark:prose-a:text-acid-green">
          <h2 class="text-grape dark:text-light-purple text-lg font-semibold tracking-wide uppercase">
            {topics.header}
          </h2>
          <ul>
            {
              topicsList.map(({ title, description, icon }) => (
                <li>
                  <div class="my-8 flex flex-row">
                    <div class="mr-5 mb-4">
                      <div class="bg-light-purple dark:bg-dark-purple dark:text-acid-green flex h-12 w-12 items-center justify-center rounded-full text-white">
                        {icon && <Icon name={icon} class="icon-light h-6 w-6" />}
                      </div>
                    </div>
                    <div>
                      <h3 class="mb-3 text-xl font-bold">{title}</h3>
                      <p class="text-muted dark:text-slate-400" set:html={description} />
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
          <ExternalLink class="mb-8" variant="secondary" href="blog">{topics.cta}</ExternalLink>
        </section>
        <!-- What I Use -->
        <section>
          <h2 id="what-i-use" class="text-grape dark:text-light-purple text-lg font-semibold tracking-wide uppercase">
            {uses.header}
          </h2>
          <div class="my-8 grid items-stretch gap-6 sm:grid-cols-1 md:grid-cols-2 dark:text-white">
            {
              use.map(({ href, title, description, icon, external }) => {
                return (
                  <a href={href}>
                    <div class="border-light-purple bg-pastel-purple dark:border-cherry dark:bg-dark-purple relative flex h-full flex-col rounded border-2 p-6 shadow-lg transition hover:shadow-md">
                      <div class="flex items-center">
                        <Icon name={icon} class="text-grape dark:text-acid-green h-10 w-10" />
                        <div class="ml-4 text-xl font-bold">
                          {title}
                          {external && (
                            <Icon name={'eva:diagonal-arrow-right-up-fill'} class="ml-1 inline h-6 w-6 pb-1" />
                          )}
                        </div>
                      </div>
                      <p class="text-muted text-md mt-4 dark:text-gray-400">{description}</p>
                    </div>
                  </a>
                );
              })
            }
          </div>
        </section>
        <h2 class="text-grape dark:text-light-purple text-base font-semibold tracking-wide uppercase md:hidden">
          {contact}
        </h2>
      </div>
      <aside class="col-start-2 col-end-3 hidden md:col-span-1 md:block">
        <ul class="text-acid-green lowercase md:sticky md:top-28 lg:ml-8">
          <li class="mb-2">
            <Chip value={nav.education} variant="secondary" href="#education" />
          </li>
          <li class="mb-2">
            <Chip value={skills.header} variant="secondary" href="#skills" />
          </li>
          {
            links.map(({ href, title }) => {
              return (
                <li class="mb-2">
                  <Chip value={title} href={href} />
                </li>
              );
            })
          }
        </ul>
      </aside>
    </div>
  </div>
  <ul
    class="via-muted-purple dark:via-darker-purple sticky bottom-16 mx-6 my-8 flex flex-row flex-wrap bg-linear-to-t from-transparent from-0% via-10% pb-4 md:top-28 md:hidden"
  >
    {
      links.map(({ href, title }) => {
        return (
          <li class="bg-grape dark:bg-cherry mr-2 mb-2 inline-block rounded-md px-2 py-0.5 font-medium lowercase">
            <a class="hover:text-primary dark:text-acid-green text-white dark:hover:text-gray-200" href={href}>
              {title}
            </a>
          </li>
        );
      })
    }
  </ul>
  <script define:vars={{ aliases: aliases }}>
    function typeWords(selector, words, speed = 100, pause = 1000) {
      const el = document.querySelector(selector);
      if (!el || !words.length) return;

      let wordIndex = 0;
      let charIndex = 0;
      let deleting = false;

      function step() {
        const currentWord = words[wordIndex];

        if (!deleting) {
          // typing
          el.textContent = currentWord.slice(0, charIndex + 1);
          charIndex++;
          if (charIndex === currentWord.length) {
            if (wordIndex === words.length - 1) return; // last word done
            deleting = true;
            return setTimeout(step, pause);
          }
        } else {
          // deleting
          el.textContent = currentWord.slice(0, charIndex - 1);
          charIndex--;
          if (charIndex === 0) {
            deleting = false;
            wordIndex++;
          }
        }

        setTimeout(step, deleting ? speed / 2 : speed);
      }

      step();
    }

    typeWords('.me', aliases.split(','), 120, 1000);
  </script>
</Layout>
