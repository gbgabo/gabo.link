---
import { getIntlayer, localeMap, getPrefix } from 'intlayer';
import { BLOG } from '~/config.mjs';

import Layout from '~/layouts/PageLayout.astro';
import PostLayout from '~/layouts/ListLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Filter from '~/components/widgets/Filter.astro';

import { fetchPosts } from '~/utils/blog';
import { getBlogPermalink, TAG_BASE } from '~/utils/permalinks';
import Headline from '~/components/blog/Headline.astro';
import Chip from '~/components/widgets/Chip.astro';

export const getStaticPaths = async ({ paginate }) => {
  if (BLOG?.disabled || BLOG?.tag?.disabled) return [];

  const paths = await Promise.all(
    localeMap(async ({ locale }) => {
      const posts = await fetchPosts(locale);

      const tags = new Set<string>();

      posts.forEach((post) => {
        if (Array.isArray(post.tags)) {
          post.tags.forEach((tag) => tags.add(tag.toLowerCase()));
        }
      });

      return Array.from(tags).flatMap((tag) =>
        paginate(
          posts.filter((post) => Array.isArray(post.tags) && post.tags.some((item) => item.toLowerCase() === tag)),
          {
            params: {
              locale: getPrefix(locale).localePrefix,
              blog: TAG_BASE || undefined,
              tag,
            },
            pageSize: BLOG.postsPerPage,
            props: {
              tag,
              locale,
            },
          }
        )
      );
    })
  );

  return paths.flat();
};

const { page, tag, locale } = Astro.props;
const { meta: metadata } = getIntlayer('app', locale);

const currentPage = page.currentPage ?? 1;
const meta = {
  title: `Posts by tag '${tag}'${currentPage > 1 ? ` — Page ${currentPage} ` : ''}`,
  description: metadata.description,
  image: `/api/og/tag/${tag}.png`,
  noindex: BLOG?.tag?.noindex,
};
---

<Layout
  breadcrumbs={[
    { title: 'blog', href: getBlogPermalink() },
    { title: `#${tag}`, href: '#top' },
  ]}
  meta={meta}
>
  <PostLayout>
    <Fragment slot="heading">
      <Headline left
        >Tag:<Chip value={tag} variant="secondary" class="text-darker-purple rounded-xl px-4 py-2" /></Headline
      >
    </Fragment>

    <BlogList posts={page.data} />
    <Fragment slot="floating-bar">
      <Filter />
    </Fragment>
    <Fragment slot="footer">
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </Fragment>
  </PostLayout>
</Layout>
