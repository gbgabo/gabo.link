---
import { getLocaleFromPath, getIntlayer, type LocalesValues } from 'intlayer';
import { Icon } from 'astro-icon/components';
import { getBlogPermalink } from '~/utils/permalinks';

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const { post } = getIntlayer('blog', locale);
---

<div class="mx-auto max-w-3xl px-6 pt-8 pb-12 sm:px-6 md:pt-4 md:pb-20">
  <a class="btn btn-ghost px-3 md:px-3" href={getBlogPermalink(Astro.url.pathname)}
    ><Icon name="tabler:chevron-left" class="mr-1 -ml-1.5 h-5 w-5" /> {post.backToBlog}</a
  >
</div>
