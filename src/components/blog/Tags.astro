---
import { getPermalink } from '~/utils/permalinks';

import { BLOG } from '~/config.mjs';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  enableLink?: boolean;
}

const { tags, class: className = 'text-sm', enableLink = true } = Astro.props;
---

{
  tags && Array.isArray(tags) && (
    <ul class={className}>
      {tags.map((tag) => (
        <li class="text-darker-purple bg-light-purple/30 dark:bg-light-purple mr-2 mb-2 inline-block rounded-md px-2 py-0.5 font-medium lowercase">
          {BLOG?.tag?.disabled ? (
            tag
          ) : enableLink ? (
            <a
              href={getPermalink(Astro.url.pathname, tag, 'tag')}
              class="dark:text-darker-purple hover:text-primary dark:hover:text-gray-200"
            >
              {tag}
            </a>
          ) : (
            <span class="dark:text-darker-purple">{tag}</span>
          )}
        </li>
      ))}
    </ul>
  )
}
