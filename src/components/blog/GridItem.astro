---
import { getLocaleFromPath, getIntlayer, type LocalesValues } from 'intlayer';
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import { BLOG } from '~/config.mjs';
import type { Post } from '~/types';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { categoryData } from '~/data';

export interface Props {
  post: Post;
}

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const { categories } = getIntlayer('blog', locale);

const { post } = Astro.props;
const image = await findImage(post.image);
const category = categoryData[post.category]
  ? categoryData[post.category]
  : {
      classes: {
        filled: 'text-darker-purple bg-light-purple',
        outline: 'text-pink',
      },
      icon: 'tabler:file-text',
    };
---

<article class="mb-6 transition">
  <div class="relative mb-5 rounded bg-gray-400 shadow-lg md:h-64 dark:bg-slate-700">
    <a
      class:list={[
        'absolute -bottom-3 left-2 z-10 flex w-fit items-center rounded-lg p-1 pr-3 text-sm capitalize shadow-lg',
        category.classes.filled,
      ]}
      href={getPermalink(post.category, 'category')}
    >
      <Icon class="mr-1 h-6 w-6 py-1" name={category.icon} />
      <>{categories[post.category]}</>
    </a>
    {
      image && (
        <Picture
          src={image}
          class="w-full rounded bg-gray-400 shadow-lg md:h-full md:w-auto md:object-cover dark:bg-slate-700"
          widths={[400, 900]}
          width={400}
          height={224}
          sizes="(max-width: 900px) 400px, 900px"
          alt={post.title}
          aspectRatio="16:9"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
  <h3 class="font-heading mb-2 text-xl leading-tight font-bold">
    {
      BLOG?.post?.disabled ? (
        post.title
      ) : (
        <a
          href={getPermalink(post.permalink, 'post')}
          class="hover:text-primary transition duration-200 ease-in dark:hover:text-blue-700"
        >
          {post.title}
        </a>
      )
    }
  </h3>
  <p class="text-muted text-lg dark:text-slate-400">{post.excerpt || post.description}</p>
</article>
