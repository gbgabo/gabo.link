---
import { Icon } from 'astro-icon/components';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import i18next, { t } from 'i18next';
---

<dialog
  data-search-dialog
  data-pagefind-ignore="all"
  class="fixed m-auto h-fit w-full max-w-3xl rounded-b-4xl md:max-h-3/4"
>
  <PagefindConfig />
  <div class="pagefind-ui relative">
    <div class="sticky top-0 z-10 p-1">
      <pagefind-input></pagefind-input>
    </div>
    <pagefind-summary></pagefind-summary>
    <div class="p-2"><pagefind-results show-images></pagefind-results></div>
  </div>

  <div
    class="bg-light-purple text-grape dark:bg-dark-purple dark:text-light-purple -mt-5 hidden rounded-b-3xl pt-14 pb-9"
  >
    <div class="mb-5 flex flex-col items-center px-4 text-center">
      <Icon class="text-darker-purple dark:text-acid-green mb-1 h-12 w-12" name="tabler:search" />
      <h1 class="text-darker-purple dark:text-acid-green mb-2 text-xl font-bold">{t('site.search.title')}</h1>
      <p>{t('site.search.description')}</p>
    </div>
  </div>
  <button
    data-search-close
    class="text btn-primary sticky bottom-2 left-4 inline-flex w-fit flex-row items-center rounded-full px-3 py-2 font-medium"
  >
    <Icon class="h-7 w-7" name="tabler:x" />
  </button>
</dialog>
