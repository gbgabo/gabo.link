---
import { getLocaleFromPath, getIntlayer } from 'intlayer';
import type { LocalesValues } from 'intlayer';
import type { Post } from '~/types';

import { Icon } from 'astro-icon/components';

export interface Props {
  headings: Post['headings'];
}

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const { post } = getIntlayer('blog', locale);

const { headings } = Astro.props;
---

<button
  class="bg-grape dark:bg-cherry dark:text-acid-green fixed right-3 bottom-20 z-10 m-auto my-0 h-fit items-center rounded-2xl p-3 text-white shadow-md md:sticky md:mb-2 md:flex md:w-fit md:p-2"
  data-aw-toggle-toc
  aria-label="Table of content"
>
  <Icon class="h-8 w-8 md:p-1" name="tabler:list" />
  <p class="m-0 mx-2 hidden md:block">{post.toc}</p>
</button>
<nav
  class="not-prose animate-fade-up border-light-purple bg-pastel-purple text-darker-purple dark:border-cherry dark:bg-darker-purple fixed right-0 bottom-24 m-3 hidden max-h-96 overflow-auto overscroll-contain rounded-md border-2 shadow-md md:absolute md:top-6 md:bottom-auto md:left-0 md:backdrop-blur-sm dark:text-slate-300"
>
  <ul class="px-5 pt-5">
    {
      headings.map(({ slug, text, depth }) => (
        <li class="px-3 py-1">
          <a class="" href={`#${slug}`}>
            {depth == 1 ? (
              <b class="text-grape dark:text-acid-green text-xl font-bold">{`${text}`}</b>
            ) : (
              <p style={{ 'margin-left': `${depth * 0.45}rem` }}>{`${text}`}</p>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  <div
    class="bg-pastel-purple/90 text-grape dark:bg-darker-purple/90 dark:text-light-purple sticky bottom-0 left-0 flex w-full justify-center backdrop-blur-sm"
  >
    <a class="inline-flex items-center justify-center p-2 font-bold" href="#">
      <Icon class="mr-1 h-5 w-5" name="tabler:caret-up-filled" />
      {post.top}
    </a>
  </div>
</nav>
