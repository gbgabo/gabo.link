---
export interface Props {
  breadcrumbs?: Array<{ title: string; href: string }>;
}

const { breadcrumbs } = Astro.props;
---

<Fragment>
  {
    breadcrumbs.map(({ title, href }, index) => (
      <>
        <span class="text-2xl text-inherit">/</span>
        <a
          class={`mx-1 my-1 inline-flex items-center justify-center rounded-lg text-center leading-snug lowercase ${index + 1 == breadcrumbs.length ? 'text-grape dark:text-light-purple font-extrabold' : 'font-medium text-inherit'} transition duration-200 ease-in`}
          href={href}
        >
          {title}
        </a>
      </>
    ))
  }
</Fragment>
