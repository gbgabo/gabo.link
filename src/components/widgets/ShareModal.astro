---
import { Icon } from 'astro-icon/components';
import { generateQR } from '~/utils/permalinks';
import SocialShare from '~/components/common/SocialShare.astro';

export interface Props {
  href: string | URL;
  text?: string;
}

const { href, text } = Astro.props;
const qrcode = await generateQR(href);
const classes = ['left-0 top-0', 'right-0 top-0', 'bottom-0 left-0', 'bottom-0 right-0'];
---

<dialog data-share-dialog>
  <button
    data-share-close
    class="bg-grape text-acid-green dark:bg-cherry dark:text-acid-green absolute right-3 bottom-3 h-12 w-12 rounded-full text-white"
    autofocus
  >
    <Icon class="m-auto h-8 w-8 py-2" name="ep:close-bold" />
  </button>
  <p
    class="text-darker-purple dark:text-light-purple mx-auto mb-4 flex w-4/5 text-2xl font-bold"
    aria-label="Share button"
  >
    <Icon class="h-8 w-8 md:p-1" name="tabler:share" />
    <span class="m-0 mx-2 md:block">Share:</span>
  </p>
  {text && <p class="text-grape dark:text-acid-green mx-auto mb-4 w-4/5">{text}</p>}
  <div class="relative mx-auto w-fit">
    {classes.map((clas) => <div class={`${clas} bg-light-purple absolute h-1/3 w-1/3 rounded-3xl`} />)}
    <div class="bg-darker-purple relative z-20 m-2 rounded-3xl">
      <img src={qrcode} alt="" class="relative z-30 p-3" />
    </div>
  </div>
  <p class="text-darker-purple dark:text-light-purple mt-4 text-center text-sm">{href}</p>
  <SocialShare text={text} url={href} label={false} class="text-grape dark:text-light-purple mt-5 align-middle" />
</dialog>
<button
  class="bg-light-purple text-darker-purple fixed right-3 bottom-36 z-10 float-right my-0 h-fit items-center rounded-xl p-2 shadow-md md:top-60 md:mb-2 md:flex md:w-fit md:rounded-2xl md:p-2"
  aria-label="Share button"
  data-share-open
>
  <Icon class="h-6 w-6 md:h-8 md:w-8 md:p-1" name="tabler:share" />
</button>
