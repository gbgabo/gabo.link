---
import { getLocaleFromPath, getIntlayer, type LocalesValues } from 'intlayer';

import { Icon } from 'astro-icon/components';
import Tags from '~/components/blog/Tags.astro';

import { fetchTags } from '~/utils/blog';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { categoryData } from '~/data';

export interface Props {
  selected?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const { categories } = getIntlayer('blog', locale);

const { selected } = Astro.props;
const categoriesSlugs = ['articles', 'lists'];

const tags = await fetchTags(locale);
---

<div
  data-filter
  class="animate-fade-up border-light-purple bg-pastel-purple dark:border-cherry dark:bg-darker-purple md:bg-muted-purple z-10 hidden rounded-lg border-2 p-5 shadow-md md:block md:border-0 md:p-0 md:shadow-none"
>
  <div class="mb-3">
    <p class="text-muted z-10 pb-3 font-semibold dark:text-slate-400">{categories.title}:</p>
    <div class="grid grid-cols-2 gap-2">
      {
        categoriesSlugs.map((slug) => {
          return (
            <a
              class={`btn col-span-1 px-1 ${slug === selected && 'btn-primary'}`}
              href={(slug === selected && getBlogPermalink()) || getPermalink(slug, 'category')}
            >
              <Icon class="mr-1 h-5 w-5" name={categoryData[slug].icon} />
              {categories[slug]}
            </a>
          );
        })
      }
    </div>
  </div>
  <div>
    <p class="text-muted z-10 pb-3 font-semibold dark:text-slate-400">Tags:</p>
    <Tags tags={tags} />
  </div>
</div>

<button
  class="bg-grape dark:bg-cherry dark:text-acid-green fixed right-3 bottom-20 z-10 rounded-2xl p-3 text-white shadow-md md:hidden"
  data-toggle-filter
  aria-label="Post filter"
>
  <Icon class="h-8 w-8" name="material-symbols:filter-list-rounded" />
</button>
