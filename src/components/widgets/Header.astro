---
import { getHomePermalink, getAsset, getPermalink } from '~/utils/permalinks';
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Breadcrumbs from '~/components/widgets/Breadcrumbs.astro';
import Navigation from '~/components/widgets/Navigation.astro';
import LanguageSelector from '~/components/common/LanguageSelector.astro';

interface Link {
  text: string;
  href: string | string[];
  ariaLabel?: string;
  icon?: string;
}

interface ActionLink extends Link {
  type?: string;
}

export interface MenuLink extends Link {
  links?: Array<Link>;
}

export interface Props {
  links?: Array<MenuLink>;
  actions?: Array<ActionLink>;
  isSticky?: boolean;
  showToggleTheme?: boolean;
  showSearch?: boolean;
  showRssFeed?: boolean;
  position?: string;
  breadcrumbs?: Array<{ title: string; href: string }>;
}

const {
  links = [],
  actions = [],
  isSticky = false,
  showSearch = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
  breadcrumbs,
} = Astro.props;
---

<header
  class:list={[
    'animate-fade-up bg-muted-purple dark:bg-darker-purple fixed bottom-0 z-40 mx-auto w-full flex-none transition-all ease-in md:sticky md:top-0 md:bg-transparent md:dark:bg-transparent',
    isSticky && 'hidden md:block',
  ]}
  id="header"
>
  <div class="mx-auto w-full max-w-7xl px-3 py-3 md:flex md:justify-start md:px-4 md:py-3.5">
    <Navigation links={links} showToggleTheme />
    <div class:list={[{ 'mr-auto': position === 'right' }, 'flex justify-between md:order-first']}>
      <a class="flex items-center" href={getHomePermalink(Astro.url.pathname)}>
        <Logo collapsable={breadcrumbs} />
      </a>
      <div class="my-auto flex w-full md:hidden">
        {breadcrumbs && <Breadcrumbs {breadcrumbs} />}
      </div>
      <div class="flex items-center md:hidden">
        {
          showSearch && (
            <button
              type="button"
              class="dark:text-light-purple dark:hover:bg-dark-purple dark:focus:ring-cherry inline-flex items-center rounded-lg p-2.5 text-sm hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 focus:outline-none"
              aria-label="Search button"
              data-search-open
            >
              <Icon name="tabler:search" class="h-6 w-6" />
            </button>
          )
        }
        <ToggleMenu />
      </div>
    </div>
    <div class:list={[{ 'ml-auto': position === 'left' }, 'ml-auto flex items-center md:mb-0 md:self-center']}>
      <div class="hidden items-center md:flex">
        {
          showSearch && (
            <button
              type="button"
              class="dark:text-light-purple dark:hover:bg-dark-purple dark:focus:ring-cherry inline-flex items-center rounded-lg p-2.5 text-sm hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 focus:outline-none"
              aria-label="Search button"
              data-search-open
            >
              <Icon name="tabler:search" class="h-5 w-5" />
            </button>
          )
        }
        {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" />}
        {
          showRssFeed && (
            <a
              class="dark:text-light-purple dark:hover:bg-dark-purple inline-flex items-center rounded-lg p-2.5 text-sm hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 focus:outline-none dark:focus:ring-gray-700"
              aria-label="RSS Feed"
              href={getAsset('/rss.xml')}
            >
              <Icon name="tabler:rss" class="h-5 w-5" />
            </a>
          )
        }
        {
          actions?.length ? (
            <span class="ml-4">
              {actions.map(({ text, href, type }) => (
                <a
                  class:list={[
                    'btn ml-2 px-5.5 py-2.5 text-sm font-semibold shadow-none md:px-6',
                    { 'btn-ghost': type === 'ghost', 'btn-primary': type === 'primary' },
                  ]}
                  href={getPermalink(Astro.url.pathname, ...href)}
                >
                  <Fragment set:html={text} />
                </a>
              ))}
            </span>
          ) : (
            ''
          )
        }
        <LanguageSelector />
      </div>
    </div>
  </div>
</header>
