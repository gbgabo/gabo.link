---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';

import { LanguageSelector } from 'astro-i18next/components';

import i18next, { t } from 'i18next';
import { getHomePermalink, getAsset, getPermalink } from '~/utils/permalinks';
import Breadcrumbs from './Breadcrumbs.astro';

interface Link {
  text: string;
  href: string | string[];
  ariaLabel?: string;
  icon?: string;
}

interface ActionLink extends Link {
  type?: string;
}

interface MenuLink extends Link {
  links?: Array<Link>;
}

export interface Props {
  links?: Array<MenuLink>;
  actions?: Array<ActionLink>;
  isSticky?: boolean;
  showToggleTheme?: boolean;
  showSearch?: boolean;
  showRssFeed?: boolean;
  position?: string;
  breadcrumbs?: Array<{ title: string; href: string }>;
}

let menuIndex = 1;

const pathname = Astro.url.pathname;

const delayClasses = [
  'delay-100',
  'delay-200',
  'delay-300',
  'delay-400',
  'delay-500',
  'delay-600',
  'delay-700',
  'delay-800',
  'delay-900',
];

const delayClassesMd = [
  'md:delay-100',
  'md:delay-200',
  'md:delay-300',
  'md:delay-400',
  'md:delay-500',
  'md:delay-600',
  'md:delay-700',
  'md:delay-800',
  'md:delay-900',
];

const {
  links = [],
  actions = [],
  isSticky = false,
  showSearch = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
  breadcrumbs,
} = Astro.props;
---

<header
  class:list={[
    'animate-fade-up bg-muted-purple dark:bg-darker-purple fixed bottom-0 z-40 mx-auto w-full flex-none transition-all ease-in md:sticky md:top-0 md:bg-transparent md:dark:bg-transparent',
    isSticky && 'hidden md:block',
  ]}
  id="header"
>
  <div class="mx-auto w-full max-w-7xl px-3 py-3 md:flex md:justify-start md:px-4 md:py-3.5">
    <nav
      class="menu-list md:show bg-pastel-purple/90 dark:bg-darker-purple/90 absolute bottom-16 left-0 mx-auto h-fit w-full max-w-7xl overflow-hidden p-2 md:static md:mx-5 md:flex md:h-auto md:w-auto md:items-center md:justify-start md:overflow-visible md:bg-inherit dark:text-slate-200 md:dark:bg-inherit"
      aria-label="Main navigation"
    >
      <ul
        class="flex w-full flex-col text-xl md:w-auto md:flex-row md:items-center md:self-center md:pt-0 md:text-base"
      >
        {
          links.map(({ text, href, links }, index) => {
            const permalink = getPermalink(...href);
            return (
              <li class={links?.length ? 'dropdown' : ''}>
                {links?.length ? (
                  <>
                    <button
                      class:list={[
                        'menu-item dark:hover:bg-dark-purple flex w-full items-center rounded-md px-4 py-3 font-medium hover:text-gray-900 md:p-0 md:hover:bg-gray-200 dark:hover:text-white',
                        delayClasses[menuIndex + index],
                        delayClassesMd[index],
                      ]}
                    >
                      {href ? (
                        <a
                          class={`w-full text-left lowercase md:px-4 md:py-2 ${permalink === pathname && 'text-grape dark:text-light-purple font-extrabold'}`}
                          href={permalink}
                        >
                          {t(text)}
                          <Icon name="tabler:chevron-down" class="ml-0.5 hidden h-3.5 w-3.5 md:inline" />
                        </a>
                      ) : (
                        <span>
                          {t(text)}
                          <Icon name="tabler:chevron-down" class="ml-0.5 hidden h-3.5 w-3.5 md:inline" />
                        </span>
                      )}
                    </button>
                    <ul class="dropdown-menu dark:md:bg-dark-purple rounded pl-4 font-medium drop-shadow-xl md:absolute md:hidden md:min-w-50 md:bg-white/90 md:pl-0 md:backdrop-blur-md">
                      {links.map(({ text: text2, href: href2 }, index2) => {
                        menuIndex = index2 === 0 ? menuIndex + 1 : menuIndex + index2;
                        const permalink2 = getPermalink(...href2);
                        return (
                          <li>
                            <a
                              class:list={[
                                'menu-item whitespace-no-wrap dark:hover:bg-darker-purple md:animate-fade-up block px-5 py-3 lowercase first:rounded-t last:rounded-b md:py-2 md:hover:bg-gray-200',
                                delayClasses[menuIndex],
                                delayClassesMd[index2],
                                permalink2 === pathname && 'text-grape dark:text-light-purple font-extrabold',
                              ]}
                              href={permalink2}
                            >
                              {t(text2)}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      `menu-item dark:hover:bg-dark-purple flex items-center rounded-md px-4 py-3 lowercase hover:text-gray-900 md:py-2 md:hover:bg-gray-200 dark:hover:text-white`,
                      `${delayClasses[menuIndex + index]}`,
                      `${delayClassesMd[index]}`,
                      permalink === pathname ? 'text-grape dark:text-light-purple font-extrabold' : 'font-medium',
                    ]}
                    href={permalink}
                  >
                    {t(text)}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
      <div class="absolute right-2 bottom-2 flex flex-col gap-3 md:hidden">
        {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" />}
        <LanguageSelector
          languageMapping={{ en: '', 'pt-BR': '' }}
          showFlag={true}
          class="bg-pastel-purple dark:bg-dark-purple dark:text-light-purple dark:hover:bg-dark-purple inline-flex items-center rounded-lg p-2.5 text-sm hover:bg-gray-100"
        />
      </div>
    </nav>
    <div class:list={[{ 'mr-auto': position === 'right' }, 'flex justify-between md:order-first']}>
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo collapsable={breadcrumbs} />
      </a>
      <div class="my-auto flex w-full md:hidden">
        {breadcrumbs && <Breadcrumbs {breadcrumbs} />}
      </div>
      <div class="flex items-center md:hidden">
        {
          showSearch && (
            <button
              type="button"
              class="dark:text-light-purple dark:hover:bg-dark-purple dark:focus:ring-cherry inline-flex items-center rounded-lg p-2.5 text-sm hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 focus:outline-none"
              aria-label="Search button"
              data-search-open
            >
              <Icon name="tabler:search" class="h-6 w-6" />
            </button>
          )
        }
        <ToggleMenu />
      </div>
    </div>
    <div class:list={[{ 'ml-auto': position === 'left' }, 'ml-auto flex items-center md:mb-0 md:self-center']}>
      <div class="hidden items-center md:flex">
        {
          showSearch && (
            <button
              type="button"
              class="dark:text-light-purple dark:hover:bg-dark-purple dark:focus:ring-cherry inline-flex items-center rounded-lg p-2.5 text-sm hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 focus:outline-none"
              aria-label="Search button"
              data-search-open
            >
              <Icon name="tabler:search" class="h-5 w-5" />
            </button>
          )
        }
        {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" />}
        {
          showRssFeed && (
            <a
              class="dark:text-light-purple dark:hover:bg-dark-purple inline-flex items-center rounded-lg p-2.5 text-sm hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 focus:outline-none dark:focus:ring-gray-700"
              aria-label="RSS Feed"
              href={getAsset('/rss.xml')}
            >
              <Icon name="tabler:rss" class="h-5 w-5" />
            </a>
          )
        }
        {
          actions?.length ? (
            <span class="ml-4">
              {actions.map(({ text, href, type }) => (
                <a
                  class:list={[
                    'btn ml-2 px-5.5 py-2.5 text-sm font-semibold shadow-none md:px-6',
                    { 'btn-ghost': type === 'ghost', 'btn-primary': type === 'primary' },
                  ]}
                  href={getPermalink(...href)}
                >
                  <Fragment set:html={text} />
                </a>
              ))}
            </span>
          ) : (
            ''
          )
        }
        <LanguageSelector languageMapping={{ en: '', 'pt-BR': '' }} showFlag={true} class="ml-2 bg-transparent" />
      </div>
    </div>
  </div>
</header>
