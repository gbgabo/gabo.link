---
import Logo from '~/assets/images/svg/logo.svg';
export interface Props {
  title?: string;
  collapsable?: boolean;
}

const { title = "Gabo's Link", collapsable = false } = Astro.props;
---

<Logo />
<span
  class={`ml-2 self-center whitespace-nowrap text-xl text-gray-900 dark:text-white font-medium ${collapsable ? 'hidden md:block' : 'block'}`}
>
  {title}</span
>
